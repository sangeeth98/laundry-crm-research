{
  "database_architecture": {
    "engine": "PostgreSQL 16 + TimescaleDB (Order Telemetry)",
    "cache": "Redis 7.2 Cluster",
    "core_tables": [
      {
        "table_name": "stores",
        "description": "Store partner metadata, franchise agreements, and geo-coordinates",
        "fields": ["id UUID PRIMARY KEY", "company_name VARCHAR(255)", "franchise_type VARCHAR(50)", "lat DECIMAL(9,6)", "lng DECIMAL(9,6)", "royalty_rate_pct DECIMAL(4,2)", "created_at TIMESTAMP"]
      },
      {
        "table_name": "orders",
        "description": "Itemized laundry and dry cleaning orders",
        "fields": ["id UUID PRIMARY KEY", "store_id UUID REFERENCES stores(id)", "customer_phone VARCHAR(20)", "status VARCHAR(50)", "weight_kg DECIMAL(5,2)", "total_amount_inr DECIMAL(10,2)", "ai_defect_photos JSONB", "created_at TIMESTAMP"]
      },
      {
        "table_name": "garment_items",
        "description": "Individual garment itemization with thermal QR tag ID",
        "fields": ["id UUID PRIMARY KEY", "order_id UUID REFERENCES orders(id)", "qr_code_hash VARCHAR(100) UNIQUE", "category VARCHAR(100)", "fabric_brand VARCHAR(100)", "pre_existing_stains JSONB", "wash_status VARCHAR(50)"]
      },
      {
        "table_name": "iot_machine_events",
        "description": "Washer/dryer relay trigger telemetry logged from ESP32",
        "fields": ["event_id UUID PRIMARY KEY", "store_id UUID REFERENCES stores(id)", "machine_id VARCHAR(50)", "order_id UUID REFERENCES orders(id)", "power_state VARCHAR(10)", "kwh_consumed DECIMAL(8,3)", "timestamp TIMESTAMP"]
      }
    ]
  },
  "iot_relay_architecture": {
    "microcontroller": "ESP32-WROOM-32 (Dual-core 240MHz, 4MB Flash, Wi-Fi/BLE)",
    "relay_specification": "4-Channel 30A Optocoupler Isolated Relay Module (AC 250V / 30A)",
    "protocol": "MQTT over TLS (Port 8883) with Client X.509 Certificate Auth",
    "mqtt_topics": [
      {
        "topic": "laundry/store/{store_id}/machine/{machine_id}/command",
        "direction": "Cloud to ESP32",
        "payload": "{\"action\": \"UNLOCK_POWER\", \"order_id\": \"ord_89231\", \"cycle_duration_sec\": 2700}"
      },
      {
        "topic": "laundry/store/{store_id}/machine/{machine_id}/telemetry",
        "direction": "ESP32 to Cloud",
        "payload": "{\"status\": \"ACTIVE\", \"current_amps\": 12.4, \"kwh_total\": 1.45, \"vibration_sensor\": \"NORMAL\"}"
      }
    ]
  },
  "whatsapp_cloud_api_architecture": {
    "webhook_url": "https://api.cant-say-no-laundry.io/v1/webhooks/whatsapp",
    "conversational_flow": [
      "1. Customer sends 'Hi' or scans store QR code -> Bot responds with itemized menu & instant location pin pickup.",
      "2. Intake complete -> Bot sends WhatsApp interactive template with garment inspection photos & thermal QR breakdown.",
      "3. Payment -> Embedded Razorpay UPI deep-link opens GooglePay/PhonePe directly inside WhatsApp.",
      "4. Driver Dispatch -> Real-time WhatsApp live location map tracking link sent to customer."
    ]
  }
}
